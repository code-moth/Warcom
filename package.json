{
  "name": "warcom-command",
  "version": "1.0.0",
  "private": true,
  "description": "A faithful TypeScript/web port of Warcom, a War Law mass-combat resolver, verified attack-by-attack against the original compiled DOS source.",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "build": "tsc && node tools/copy-build.mjs",
    "gen:weapons": "node tools/gen-weapons.mjs",
    "gen:tables": "node tools/gen-tables.mjs",
    "test": "node --test tests/*.mjs",
    "test:reference": "bash tests/reference/build.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
